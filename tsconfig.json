{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    "strict": true,

    // Exercise 2, Demo 5: adopted after exploring `tsc --init`'s
    // generated default against this codebase. noUncheckedIndexedAccess
    // immediately caught a real gap in utils.ts's find*ById functions
    // (array[i] assumed always valid, which TS can't actually prove),
    // so it earned its spot here rather than being copied blindly.
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "noUncheckedSideEffectImports": true,

    // ESLint's no-unused-vars (Demo 4) already owns this job, no reason
    // to make two tools disagree about the same dead code.
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    "noEmit": true,
    // Exercise 2, Demo 6: flipped on once dataLoader.ts started importing
    // the still-untyped views/*.js modules. With this false, tsc refused
    // to resolve those imports at all (TS7016), which would block every
    // .ts file from importing a .js one until the whole app is migrated.
    // checkJs stays off (its default) - this only lets allowJs resolve
    // and import .js, it doesn't start type-checking it. That's Demo 7.
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist", "public"]
}
