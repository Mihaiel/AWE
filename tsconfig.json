{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    "strict": true,

    // Exercise 2, Demo 5: adopted after exploring `tsc --init`'s
    // generated default against this codebase. noUncheckedIndexedAccess
    // immediately caught a real gap in utils.ts's find*ById functions
    // (array[i] assumed always valid, which TS can't actually prove),
    // so it earned its spot here rather than being copied blindly.
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "noUncheckedSideEffectImports": true,

    // ESLint's no-unused-vars (Demo 4) already owns this job, no reason
    // to make two tools disagree about the same dead code.
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    "noEmit": true,
    // Exercise 2, Demo 6 temporarily turned this on so dataLoader.ts
    // could import the still-untyped views/*.js modules. Demo 7 finished
    // converting every remaining .js file, so there's nothing left for
    // it to apply to - back to false now that js/ is all .ts.
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    // Exercise 3, Demo 6: "react-jsx" means tsc expects Vite/esbuild to
    // do the actual JSX-to-JS transform (same noEmit split as the rest
    // of this config, tsc only checks types here), and it also means
    // files don't need `import React from "react"` just to use JSX,
    // the react-jsx runtime handles that automatically.
    "jsx": "react-jsx",

    // Exercise 3, Demo 6: without this, `import.meta.env.DEV` (used to
    // keep the React placeholder out of production builds) doesn't
    // typecheck, ImportMeta has no `env` property by default. Vite
    // ships these ambient types itself, in node_modules/vite/client.d.ts,
    // this just tells tsc to actually include them.
    "types": ["vite/client"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist", "public"]
}
